{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    // `blobatar/*` aliases resolve the library from source rather than through
    // its `exports`, which point at built JS. See `apps/demo/tsconfig.json`.
    "paths": {
      "@/*": ["./src/*"],
      "blobatar": ["../../packages/blobatar/src/index.ts"],
      "blobatar/blob": ["../../packages/blobatar/src/blob.ts"],
      "blobatar/uri": ["../../packages/blobatar/src/uri.ts"],
      "blobatar/expression": ["../../packages/blobatar/src/expression.ts"],
      "@blobatar/react": ["../../packages/react/src/index.tsx"],
      "blobatar/react": ["../../packages/blobatar/src/react.tsx"],
      "blobatar/motion.css": ["../../packages/blobatar/src/motion.css"]
    }
  },
  "include": ["."],

  /*
   * `registry/` holds the sources `shadcn build` inlines into `public/r`. They
   * import `@/components/ui/...` — the *consumer's* alias, which the shadcn CLI
   * rewrites on install and which resolves to nothing here, since this app has
   * no shadcn components of its own. Excluded rather than made to resolve: a
   * local alias that made it typecheck is a local alias that would ship in the
   * item JSON and break on every project whose `components.json` says otherwise.
   */
  "exclude": ["registry"]
}
