{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    // No `blobatar/*` paths, unlike `apps/site` and `apps/demo`.
    //
    // Those alias the library to source so that editing a curve shows up on
    // save. This app resolves it through `exports` instead — the same way a
    // fresh clone will, and therefore the same built JS anyone deploying this
    // gets. Tests here run against the published surface, so `bun --filter
    // blobatar build` has to have happened before `bun test` does.
    "types": ["bun"]
  },
  "include": ["."]
}
