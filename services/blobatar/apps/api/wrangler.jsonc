{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blobatar-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-17",

  // No `nodejs_compat`: the library is zero-dependency and the endpoint uses
  // only Request, Response and URL. Leaving the flag off keeps startup minimal
  // and makes any accidental Node import fail at build time rather than in
  // production.

  /*
   * No routes, no assets, and that is the point.
   *
   * `apps/site` is this same endpoint with the blobatar.dev hostnames and the
   * landing page attached; this config is deliberately the version with nothing
   * account-specific in it, so that a clone deploys as-is on somebody else's
   * account and answers on `blobatar-api.<subdomain>.workers.dev`. Adding a
   * custom domain here would make every deploy but ours fail on a hostname the
   * deployer does not own.
   *
   * A deployer who wants their own hostname adds it after the fact, in the
   * dashboard or as a `routes` entry — see the README.
   */

  "observability": { "enabled": true }
}
