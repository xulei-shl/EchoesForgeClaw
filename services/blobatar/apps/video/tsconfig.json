{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    // Same aliasing as `apps/site`: resolve the library from source, not from
    // its `exports`. `remotion.config.ts` repeats these for webpack, which is
    // what actually resolves them at render time.
    //
    // `blobatar/animate` is not a public entry point. It is aliased here because
    // the timing solver needs the seeded motion offsets to schedule a blink, and
    // reproducing those ranges in this app would be a second source of truth
    // that drifts silently the first time a range is retuned.
    "paths": {
      "blobatar": ["../../packages/blobatar/src/index.ts"],
      "blobatar/blob": ["../../packages/blobatar/src/blob.ts"],
      "blobatar/uri": ["../../packages/blobatar/src/uri.ts"],
      "blobatar/expression": ["../../packages/blobatar/src/expression.ts"],
      "@blobatar/react": ["../../packages/react/src/index.tsx"],
      "blobatar/react": ["../../packages/blobatar/src/react.tsx"],
      "@blobatar/vue": ["../../packages/vue/src/index.ts"],
      "blobatar/vue": ["../../packages/blobatar/src/vue.ts"],
      "blobatar/internal": ["../../packages/blobatar/src/internal.ts"],
      "blobatar/animate": ["../../packages/blobatar/src/animate.ts"],
      "blobatar/motion.css": ["../../packages/blobatar/src/motion.css"]
    }
  },
  "include": ["."]
}
