{
  "name": "bookforge-backend-ts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "BookForge TypeScript 后端（Fastify + Drizzle + AI SDK）",
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:pull": "drizzle-kit pull",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.30",
    "@ai-sdk/provider": "4.0.7",
    "@amaster.ai/pi-image-gen": "^0.1.9",
    "@earendil-works/pi-coding-agent": "^0.84.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/jwt": "^9.1.0",
    "@fastify/multipart": "^9.4.0",
    "@fastify/static": "^8.3.0",
    "adm-zip": "^0.5.18",
    "ai": "7.0.66",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.0",
    "playwright-core": "^1.62.1",
    "undici": "^7.29.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.13.3",
    "drizzle-kit": "^0.31.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vitest": "4.1.10"
  }
}
